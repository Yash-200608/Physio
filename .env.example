# Camera index (0, 1, …) or an OpenCV-compatible URL / device path.
CAMERA_URL=0

# Vision-only posture thresholds (scale-invariant 3D geometry)
POSTURE_MIN_NOSE_HIP_GAP=0.10
POSTURE_SLOUCH_ALERT_THRESH=55
POSTURE_LEAN_ALERT_DEG=12
POSTURE_TILT_ALERT_DEG=10

# Research & export logistics (written under RESEARCH_EXPORT_DIR)
RESEARCH_LOG_ENABLED=true
RESEARCH_LOG_INTERVAL_SEC=0.5
RESEARCH_EXPORT_DIR=exports
